# ==========================================
# Telegram Live Multi-Account Bot Config
# ==========================================

# ১. Telegram Bot Token (@BotFather থেকে পাওয়া টোকেন)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ২. Telegram API ID & API HASH (https://my.telegram.org থেকে তৈরি করা)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# ৩. Admin Telegram User ID (আপনার টেলিগ্রাম আইডি, @userinfobot থেকে দেখতে পারবেন)
ADMIN_IDS=123456789

# ৪. ডাটাবেজ ফাইল নাম (অ্যাকাউন্ট সেভ রাখার জন্য)
DATABASE_FILE=sessions.json

# ৫. প্রতিটি অ্যাকাউন্টের জয়েন ডিলে (অ্যান্ট্রি-ব্যানের জন্য ২.৫ সেকেন্ড ভালো)
JOIN_DELAY_SEC=2.5
